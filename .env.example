# Backend base URL. If set to a non-localhost URL (LAN IP, https://…ngrok…/api, etc.), the app
# uses it in __DEV__ before Metro’s host — required when Metro’s IP ≠ your API PC, when using ngrok
# for all API calls, or to avoid HTML error pages from ngrok’s browser warning on API requests.
# If you only set host:port without a path, the app adds /api. Port 8081 is coerced to 5000 (Metro returns HTML for /api/*).
# Leave unset to auto-use the same LAN host as Metro + port 5000 + /api.
EXPO_PUBLIC_API_URL=http://localhost:5000/api
# EXPO_PUBLIC_API_STRICT_URL=1

# Google Sign-In (OAuth 2.0 client IDs from the same GCP project — public in the app).
# Copy this file to .env and restart Expo (env is baked at bundle time).
#
# Android: create an "Android" OAuth client with package name = android.package in app.json
# (e.g. com.auroragrand.hotelapp) and your debug/release SHA-1 from EAS credentials or
# keytool. Put that client ID here and the same value in HotelBackend/.env as GOOGLE_ANDROID_CLIENT_ID.
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
#
# Web: create a "Web application" OAuth client. Required for Expo Go. Recommended for all builds.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
#
# Expo username (no @). Optional; used by app.config.js for EAS / manifest owner.
# EXPO_PUBLIC_EXPO_OWNER=your_expo_username
#
# Expo Go: Google OAuth relay must use a public https:// URL (Google blocks 192.168.x.x in GCP).
# Run: ngrok http 5000 — then set (same value in HotelBackend/.env as GOOGLE_OAUTH_PUBLIC_BASE):
# EXPO_PUBLIC_GOOGLE_RELAY_BASE=https://YOUR_SUBDOMAIN.ngrok-free.app
# If the phone cannot reach your PC on LAN (firewall/VPN), set EXPO_PUBLIC_API_URL to the same
# https ngrok origin + /api (e.g. https://YOUR_SUBDOMAIN.ngrok-free.app/api) so forgot-password and uploads work.
#
# Native Android dev/store builds: after changing Google env vars, rebuild the app so app.config.js
# intent filters apply. In GCP Android OAuth client, enable custom URI scheme (Advanced) if Google
# shows that error; redirect must match:
# com.googleusercontent.apps.<CLIENT_SUFFIX>:/oauth2redirect/google
