# Backend base URL (must include /api). Port/path are always used; in __DEV__ on a phone the
# HOST is taken from Metro's LAN IP so a stale IP here does not break Expo Go.
# Set EXPO_PUBLIC_API_STRICT_URL=1 only if the API runs on a different machine than Metro.
EXPO_PUBLIC_API_URL=http://localhost:5000/api
# EXPO_PUBLIC_API_STRICT_URL=1
# Same site key as backend RECAPTCHA_SITE_KEY (public; safe in the client)
EXPO_PUBLIC_RECAPTCHA_SITE_KEY=your_recaptcha_site_key
# Dev: skip invisible reCAPTCHA WebView; requires RECAPTCHA_DEV_BYPASS=1 in HotelBackend/.env
# EXPO_PUBLIC_SKIP_RECAPTCHA=1

# Google OAuth client IDs (public). Must match Google Cloud Console OAuth clients.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=your_ios_client_id.apps.googleusercontent.com
