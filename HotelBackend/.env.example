PORT=5000
# Listen on all interfaces so phones on Wi‑Fi can reach the API (Expo Go). Default in code is 0.0.0.0.
# HOST=0.0.0.0
# The server always listens even if MongoDB is down — fix MONGO_URI or start Mongo, then GET http://YOUR_PC_IP:5000/api/health should return mongo: connected.
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key

# Google Sign-In (OAuth 2.0 Web client ID — verify ID tokens from web / some flows)
GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
# Android OAuth client ID (APK) — optional but required to verify tokens issued to the Android app
GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com

# Optional — password reset emails (if omitted, reset codes are logged to the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Google reCAPTCHA (secret used only on the server; never expose to the app)
RECAPTCHA_SITE_KEY=your_recaptcha_site_key
RECAPTCHA_SECRET_KEY=your_recaptcha_secret_key

# Dev only: set to 1 so test-booking-api.js can log in (never enable in production)
# RECAPTCHA_TEST_BYPASS=1

# Local dev: skip reCAPTCHA server check (Expo Go / WebView often fails domain checks). Never in production.
# RECAPTCHA_DEV_BYPASS=1
