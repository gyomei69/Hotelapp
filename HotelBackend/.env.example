PORT=5000
# Listen on all interfaces so phones on Wi‑Fi can reach the API (Expo Go). Default in code is 0.0.0.0.
# HOST=0.0.0.0
# The server always listens even if MongoDB is down — fix MONGO_URI or start Mongo, then GET http://YOUR_PC_IP:5000/api/health should return mongo: connected.
MONGO_URI=your_mongodb_connection_string
JWT_SECRET=your_jwt_secret_key

# Dev toggle: set to 0/false/off to allow local users to log in without verifying email.
# Default is ON (verification required).
REQUIRE_EMAIL_VERIFICATION=1

# Optional — public base URL for absolute avatar links (no trailing slash). Falls back to request Host.
# Example: https://YOUR_SUBDOMAIN.ngrok-free.app
PUBLIC_BASE_URL=

# Google Sign-In: use the same OAuth client IDs as the Expo app (.env EXPO_PUBLIC_GOOGLE_*).
# verifyIdToken accepts any audience listed here (Web and/or Android issuers).
GOOGLE_WEB_CLIENT_ID=your_web_client_id.apps.googleusercontent.com
GOOGLE_ANDROID_CLIENT_ID=your_android_client_id.apps.googleusercontent.com
# Web client secret — required for Expo Go Google relay (GET /api/auth/google/expo/*).
GOOGLE_WEB_CLIENT_SECRET=your_web_client_secret
# Public https origin of this server (no /api). Google rejects http://192.168.x.x for Web OAuth redirects.
# Use ngrok: `ngrok http 5000` → set GOOGLE_OAUTH_PUBLIC_BASE=https://YOUR_SUBDOMAIN.ngrok-free.app
# Replace with the https URL ngrok prints when you run: ngrok http 5000 (do not use example hosts).
GOOGLE_OAUTH_PUBLIC_BASE=
#
# In Google Cloud → Web client → Authorized redirect URIs, add exactly:
#   {GOOGLE_OAUTH_PUBLIC_BASE}/api/auth/google/expo/callback

# Optional — password reset emails (if omitted, reset codes are logged to the server console)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Gmail App Password aliases (supported)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_16_char_app_password

# Dev-only: set to 1 to log emails to console instead of sending.
# NEVER enable this in production if you expect real emails to arrive.
EMAIL_LOG_ONLY=0
